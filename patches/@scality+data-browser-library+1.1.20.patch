@@ -0,0 +1,14 @@
+import type { QueryKey } from '@tanstack/react-query';
+import type { DataBrowserToolContext } from './types';
+/**
+ * Apply the data-browser cache prefix to a logical query key. Mirrors
+ * DataBrowserProvider's `useInvalidateQueries` so tool-side invalidations
+ * target the same fully-qualified keys the panels' `useQuery` callsites use.
+ */
+export declare function keyWithPrefix(context: DataBrowserToolContext, key: QueryKey): QueryKey;
+/**
+ * Convenience for the common case: invalidate one or more logical keys
+ * against the QueryClient the data-browser panels observe. See
+ * `pickQueryClient` for why we don't blindly trust `context.queryClient`.
+ */
+export declare function invalidateAfter(context: DataBrowserToolContext, keys: QueryKey[]): void;
diff --git a/node_modules/@scality/data-browser-library/dist/mcpTools/cacheSyncHelpers.js b/node_modules/@scality/data-browser-library/dist/mcpTools/cacheSyncHelpers.js
new file mode 100644
index 0000000..1cb4a83
--- /dev/null
+++ b/node_modules/@scality/data-browser-library/dist/mcpTools/cacheSyncHelpers.js
@@ -0,0 +1,21 @@
+import { defaultQueryClient } from "../components/providers/QueryProvider.js";
+function keyWithPrefix(context, key) {
+    const base = Array.isArray(key) ? key : [
+        key
+    ];
+    return context.queryKeyPrefix ? [
+        context.queryKeyPrefix,
+        ...base
+    ] : base;
+}
+function pickQueryClient(provided) {
+    if (provided && provided.constructor === defaultQueryClient.constructor) return provided;
+    return defaultQueryClient;
+}
+function invalidateAfter(context, keys) {
+    const qc = pickQueryClient(context.queryClient);
+    for (const key of keys)qc.invalidateQueries({
+        queryKey: keyWithPrefix(context, key)
+    });
+}
+export { invalidateAfter, keyWithPrefix };
