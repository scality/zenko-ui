+import { QueryClient } from "@tanstack/react-query";
+import { defaultQueryClient } from "../../components/providers/QueryProvider.js";
+import { createBucketTool } from "../generated/CreateBucketTool.js";
+jest.mock('../s3Client', ()=>({
+        createS3ClientFromContext: jest.fn(()=>({
+                send: jest.fn().mockResolvedValue({
+                    Location: '/test-bucket'
+                })
+            }))
+    }));
+jest.mock('../utils/autoNavigate', ()=>({
+        autoNavigateAfterOperation: jest.fn()
+    }));
+describe('createBucketTool (generated)', ()=>{
+    it('invalidates ListBuckets on the provided v5 QueryClient', async ()=>{
+        const queryClient = new QueryClient();
+        const spy = jest.spyOn(queryClient, 'invalidateQueries').mockImplementation(()=>Promise.resolve());
+        const context = {
+            getS3Config: ()=>({
+                    endpoint: 'https://s3.local',
+                    region: 'us-east-1',
+                    credentials: {
+                        accessKeyId: 'a',
+                        secretAccessKey: 'b'
+                    }
+                }),
+            navigate: ()=>{},
+            queryClient,
+            queryKeyPrefix: 'cache-id'
+        };
+        await createBucketTool.execute({
+            Bucket: 'test-bucket',
+            context
+        }, void 0);
+        expect(spy).toHaveBeenCalledTimes(1);
+        expect(spy).toHaveBeenCalledWith({
+            queryKey: [
+                'cache-id',
+                'ListBuckets'
+            ]
+        });
+    });
+    it('falls back to defaultQueryClient when no queryClient is wired up', async ()=>{
+        const spy = jest.spyOn(defaultQueryClient, 'invalidateQueries').mockImplementation(()=>Promise.resolve());
+        const context = {
+            getS3Config: ()=>({
+                    endpoint: 'https://s3.local',
+                    region: 'us-east-1',
+                    credentials: {
+                        accessKeyId: 'a',
+                        secretAccessKey: 'b'
+                    }
+                }),
+            navigate: ()=>{}
+        };
+        await expect(createBucketTool.execute({
+            Bucket: 'test-bucket',
+            context
+        }, void 0)).resolves.toBeDefined();
+        expect(spy).toHaveBeenCalledWith({
+            queryKey: [
+                'ListBuckets'
+            ]
+        });
+        spy.mockRestore();
+    });
+});
