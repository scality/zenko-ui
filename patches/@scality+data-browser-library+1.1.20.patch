@@ -0,0 +1,138 @@
+import { QueryClient } from "@tanstack/react-query";
+import { defaultQueryClient } from "../../components/providers/QueryProvider.js";
+import { invalidateAfter, keyWithPrefix } from "../cacheSyncHelpers.js";
+function makeContext(overrides = {}) {
+    return {
+        getS3Config: ()=>{
+            throw new Error('not used by cacheSyncHelpers');
+        },
+        navigate: ()=>{},
+        ...overrides
+    };
+}
+describe('keyWithPrefix', ()=>{
+    it('returns the key unchanged when no prefix is set', ()=>{
+        const ctx = makeContext({
+            queryKeyPrefix: void 0
+        });
+        expect(keyWithPrefix(ctx, [
+            'ListBuckets'
+        ])).toEqual([
+            'ListBuckets'
+        ]);
+    });
+    it('prepends the prefix when set', ()=>{
+        const ctx = makeContext({
+            queryKeyPrefix: 'foo'
+        });
+        expect(keyWithPrefix(ctx, [
+            'ListBuckets'
+        ])).toEqual([
+            'foo',
+            'ListBuckets'
+        ]);
+    });
+    it('preserves later key parts (e.g. filter objects)', ()=>{
+        const ctx = makeContext({
+            queryKeyPrefix: 'foo'
+        });
+        const key = [
+            'ListObjects',
+            {
+                Bucket: 'b'
+            }
+        ];
+        expect(keyWithPrefix(ctx, key)).toEqual([
+            'foo',
+            'ListObjects',
+            {
+                Bucket: 'b'
+            }
+        ]);
+    });
+});
+describe('invalidateAfter', ()=>{
+    let spy;
+    beforeEach(()=>{
+        spy = jest.spyOn(defaultQueryClient, 'invalidateQueries').mockImplementation(()=>Promise.resolve());
+    });
+    afterEach(()=>{
+        spy.mockRestore();
+    });
+    it('calls defaultQueryClient.invalidateQueries once per key', ()=>{
+        const ctx = makeContext({
+            queryKeyPrefix: 'foo'
+        });
+        invalidateAfter(ctx, [
+            [
+                'ListBuckets'
+            ],
+            [
+                'ListObjects',
+                {
+                    Bucket: 'b'
+                }
+            ]
+        ]);
+        expect(spy).toHaveBeenCalledTimes(2);
+        expect(spy).toHaveBeenNthCalledWith(1, {
+            queryKey: [
+                'foo',
+                'ListBuckets'
+            ]
+        });
+        expect(spy).toHaveBeenNthCalledWith(2, {
+            queryKey: [
+                'foo',
+                'ListObjects',
+                {
+                    Bucket: 'b'
+                }
+            ]
+        });
+    });
+    it('omits the prefix when none is set', ()=>{
+        const ctx = makeContext();
+        invalidateAfter(ctx, [
+            [
+                'ListBuckets'
+            ]
+        ]);
+        expect(spy).toHaveBeenCalledWith({
+            queryKey: [
+                'ListBuckets'
+            ]
+        });
+    });
+    it('uses defaultQueryClient when context.queryClient comes from a different react-query package', ()=>{
+        const stranger = {
+            invalidateQueries: jest.fn()
+        };
+        invalidateAfter(makeContext({
+            queryClient: stranger
+        }), [
+            [
+                'ListBuckets'
+            ]
+        ]);
+        expect(spy).toHaveBeenCalledTimes(1);
+        expect(stranger.invalidateQueries).not.toHaveBeenCalled();
+    });
+    it('uses the provided client when it is a real @tanstack/react-query v5 QueryClient', ()=>{
+        const otherClient = new QueryClient();
+        const otherSpy = jest.spyOn(otherClient, 'invalidateQueries').mockImplementation(()=>Promise.resolve());
+        invalidateAfter(makeContext({
+            queryClient: otherClient
+        }), [
+            [
+                'ListBuckets'
+            ]
+        ]);
+        expect(otherSpy).toHaveBeenCalledWith({
+            queryKey: [
+                'ListBuckets'
+            ]
+        });
+        expect(spy).not.toHaveBeenCalled();
+    });
+});
